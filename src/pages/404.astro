---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Not Found | Bilal Madi</title>
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
	</head>
	<body class="min-h-screen bg-[var(--color-obsidian)] text-[var(--color-ash)] antialiased">
		<main class="grid min-h-screen place-items-center px-5">
			<section class="max-w-xl border border-white/12 bg-white/[0.045] p-8 text-center backdrop-blur-2xl">
				<p class="text-xs font-semibold tracking-[0.28em] text-cyan-100/75 uppercase">404</p>
				<h1 class="mt-5 font-display text-5xl text-white">This route is unlit.</h1>
				<p class="mt-5 text-sm leading-6 text-white/60">
					The page does not exist, but the portfolio is still one turn away.
				</p>
				<a
					class="mt-8 inline-flex rounded-full border border-white/10 bg-white/[0.035] px-4 py-2 text-sm font-medium text-white/88 transition hover:border-cyan-200/35 hover:bg-cyan-200/[0.08]"
					href="/"
				>
					Return home
				</a>
			</section>
		</main>
	</body>
</html>
