---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Not Found | Bilal Madi</title>
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@300;400;500&display=swap"
		>
	</head>
	<body class="min-h-screen bg-obsidian text-paper antialiased">
		<main class="grid min-h-screen place-items-center px-5">
			<section class="max-w-xl border border-white/12 bg-white/[0.045] p-8 text-center backdrop-blur-2xl">
				<p class="text-xs font-semibold tracking-[0.28em] text-acid uppercase">404</p>
				<h1 class="mt-5 text-5xl font-medium text-paper">This route is unlit.</h1>
				<p class="mt-5 text-sm leading-6 text-white/60">
					The page does not exist, sorry ¯\_(ツ)_/¯.
				</p>
				<a
					class="mt-8 inline-flex rounded-full border border-white/10 bg-white/[0.035] px-4 py-2 text-sm font-medium text-white/88 transition hover:border-acid/35 hover:bg-acid/[0.08]"
					href="/"
				>
					Return home
				</a>
			</section>
		</main>
	</body>
</html>
