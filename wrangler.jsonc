{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bilal-personal",
	"compatibility_date": "2026-05-14",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "bilalmadi.com",
			"custom_domain": true
		},
		{
			"pattern": "www.bilalmadi.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
